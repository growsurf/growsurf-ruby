module GrowsurfRuby
  module Models
    module Campaign
      type reward_group_update_params =
        { id: String } & GrowsurfRuby::Internal::Type::request_parameters

      class RewardGroupUpdateParams < GrowsurfRuby::Internal::Type::BaseModel
        extend GrowsurfRuby::Internal::Type::RequestParameters::Converter
        include GrowsurfRuby::Internal::Type::RequestParameters
        attr_accessor id: String
        attr_accessor name: String?
        attr_accessor order: Integer?
        attr_accessor rules: ::Array[RewardGroupRule]?
        def initialize: (
          id: String,
          ?name: String,
          ?order: Integer,
          ?rules: ::Array[RewardGroupRule | reward_group_rule],
          ?request_options: GrowsurfRuby::request_opts
        ) -> void
        def to_hash: -> ::Hash[Symbol, top]
      end
    end
  end
end
