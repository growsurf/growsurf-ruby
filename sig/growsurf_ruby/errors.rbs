module GrowsurfRuby
  module Errors
    class Error < StandardError
      attr_accessor cause: StandardError?
    end

    class ConversionError < GrowsurfRuby::Errors::Error
      def cause: -> StandardError?

      def initialize: (
        on: Class,
        method: Symbol,
        target: top,
        value: top,
        ?cause: StandardError?
      ) -> void
    end

    class APIError < GrowsurfRuby::Errors::Error
      attr_accessor url: URI::Generic

      attr_accessor status: Integer?

      attr_accessor headers: ::Hash[String, String]?

      attr_accessor body: top?

      def initialize: (
        url: URI::Generic,
        ?status: Integer?,
        ?headers: ::Hash[String, String]?,
        ?body: Object?,
        ?request: nil,
        ?response: nil,
        ?message: String?
      ) -> void
    end

    class APIConnectionError < GrowsurfRuby::Errors::APIError
      def initialize: (
        url: URI::Generic,
        ?status: nil,
        ?headers: ::Hash[String, String]?,
        ?body: nil,
        ?request: nil,
        ?response: nil,
        ?message: String?
      ) -> void
    end

    class APITimeoutError < GrowsurfRuby::Errors::APIConnectionError
      def initialize: (
        url: URI::Generic,
        ?status: nil,
        ?headers: ::Hash[String, String]?,
        ?body: nil,
        ?request: nil,
        ?response: nil,
        ?message: String?
      ) -> void
    end

    class APIStatusError < GrowsurfRuby::Errors::APIError
      def self.for: (
        url: URI::Generic,
        status: Integer,
        headers: ::Hash[String, String]?,
        body: Object?,
        request: nil,
        response: nil,
        ?message: String?
      ) -> instance

      attr_reader error_name: String?

      attr_reader error_code: String?

      attr_reader error_message: String?

      attr_reader errors: ::Array[::Hash[Symbol, top]]?

      attr_reader support_url: String?

      attr_reader policy_name: String?

      attr_reader level: String?

      attr_reader timestamp: String?

      attr_reader fraud_risk_level: String?

      attr_reader fraud_reason_code: String?

      attr_reader matched_participant_ids: ::Array[String]?

      attr_reader email: String?

      attr_reader referrer_id: String?

      attr_reader ip_address: String?

      attr_reader fingerprint: String?

      attr_reader blocked_at: String?

      def initialize: (
        url: URI::Generic,
        status: Integer,
        headers: ::Hash[String, String]?,
        body: Object?,
        request: nil,
        response: nil,
        ?message: String?
      ) -> void

      private

      def string_or_nil: (top value) -> String?

      def string_list_or_nil: (top value) -> ::Array[String]?

      def hash_list_or_nil: (top value) -> ::Array[::Hash[Symbol, top]]?
    end

    class BadRequestError < GrowsurfRuby::Errors::APIStatusError
      HTTP_STATUS: 400
    end

    class AuthenticationError < GrowsurfRuby::Errors::APIStatusError
      HTTP_STATUS: 401
    end

    class PermissionDeniedError < GrowsurfRuby::Errors::APIStatusError
      HTTP_STATUS: 403
    end

    class NotFoundError < GrowsurfRuby::Errors::APIStatusError
      HTTP_STATUS: 404
    end

    class ConflictError < GrowsurfRuby::Errors::APIStatusError
      HTTP_STATUS: 409
    end

    class UnprocessableEntityError < GrowsurfRuby::Errors::APIStatusError
      HTTP_STATUS: 422
    end

    class RateLimitError < GrowsurfRuby::Errors::APIStatusError
      HTTP_STATUS: 429
    end

    class InternalServerError < GrowsurfRuby::Errors::APIStatusError
      HTTP_STATUS: Range[Integer]
    end
  end
end
